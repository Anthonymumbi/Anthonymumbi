# Server
PORT=4000
LOG_LEVEL=info
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/movement?schema=public

# Object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=movement-uploads
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
S3_PRESIGN_TTL=900
MAX_UPLOAD_BYTES=5242880
S3_ACL=private
